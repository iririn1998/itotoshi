{
  "name": "itotoshi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @itotoshi/game dev",
    "dev:game": "pnpm --filter @itotoshi/game dev",
    "dev:backend": "pnpm --filter @itotoshi/backend dev",
    "build": "pnpm -r run build",
    "preview": "pnpm --filter @itotoshi/game preview",
    "lint": "pnpm -r run lint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "cloudflare:login": "wrangler login",
    "deploy:game": "pnpm --filter @itotoshi/game run build && wrangler pages deploy game/dist --project-name itotoshi-game",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "wrangler": "catalog:"
  },
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a"
}
